  "claims": [
    {
      "id": "graph-diffusion",
      "category": "contribution",
      "statement": "DIFUSCO learns graph-conditioned diffusion over binary edge/node variables, comparing Bernoulli and Gaussian noise.",
      "evidence": [
        {
          "source_id": "paper",
          "pdf_pages": [
            3,
            4,
            5
          ],
          "locator": "Sections 3.1-3.4"
        }
      ]
    },
    {
      "id": "supervision",
      "category": "method",
      "statement": "Training uses Concorde, LKH3 or KaMIS reference solutions; larger-task labels need not be optimal.",
      "evidence": [
        {
          "source_id": "paper",
          "pdf_pages": [
            6,
            9,
            18
          ],
          "locator": "Datasets; FAQ A.1"
        }
      ]
    },
    {
      "id": "decoding",
      "category": "method",
      "statement": "Raw diffusion does not guarantee feasibility; TSP uses greedy construction plus optional 2-opt or MCTS, and MIS uses conflict-free greedy insertion.",
      "evidence": [
        {
          "source_id": "paper",
          "pdf_pages": [
            5,
            6,
            23,
            26
          ],
          "locator": "Sections 3.5 and F; Figure 12"
        }
      ]
    },
    {
      "id": "backbone",
      "category": "method",
      "statement": "Both tasks use a 12-layer width-256 AGNN, with different node/edge variables and separate trained models.",
      "evidence": [
        {
          "source_id": "paper",
          "pdf_pages": [
            5,
            23
          ],
          "locator": "Section 3.4; task-specific training details"
        }
      ]
    },
    {
      "id": "tsp-results",
